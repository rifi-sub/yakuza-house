{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://alilyback.duckdns.org/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://alilyback.duckdns.org/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
